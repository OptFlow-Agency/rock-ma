---
import { Image } from "astro:assets";
import { Star } from "@lucide/astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  category: string;
  name: string;
  price: string;
  reviews: number;
  rating?: number;
  href?: string;
}

const { image, alt, category, name, price, reviews, rating = 5, href = "#" } = Astro.props;
---

<li class="product group relative flex flex-col rounded-sm border border-silver bg-[#f3f4f1] p-3 transition-[border-color,box-shadow] duration-300 hover:border-graphite hover:shadow-[0_14px_30px_-18px_rgba(3,1,5,0.55)] sm:p-4">
  <div class="product__stage relative aspect-square overflow-hidden">
    <Image
      src={image}
      alt={alt}
      widths={[240, 360, 480, 720]}
      sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 44vw"
      class="absolute inset-0 h-full w-full object-contain p-1 transition-transform duration-500 [transition-timing-function:var(--ease-out)] group-hover:scale-[1.06]"
    />
  </div>
  <div class="mt-3 flex flex-col items-start gap-1.5 text-[0.72rem] min-[420px]:flex-row min-[420px]:items-center min-[420px]:justify-between leading-none text-graphite sm:text-xs">
    <span class="uppercase tracking-wide">{category}</span>
    <span class="flex items-center gap-1" aria-label={`${rating} out of 5 stars, ${reviews} reviews`}>
      <span class="flex" aria-hidden="true">
        {Array.from({ length: 5 }).map((_, i) => (
          <Star size={11} fill={i < rating ? "currentColor" : "none"} stroke-width={1.5} class="text-ink" />
        ))}
      </span>
      <span class="whitespace-nowrap tabular-nums" aria-hidden="true">({reviews} reviews)</span>
    </span>
  </div>
  <h3 class="mt-2 text-[0.95rem] font-bold leading-snug text-ink sm:text-base">
    <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-offset-4">{name}</a>
  </h3>
  <p class="mt-1 text-[0.95rem] tabular-nums text-graphite sm:text-base">{price}</p>
</li>
